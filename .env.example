[TEMPLATE]
# Web3Forms API Key for Contact Form Submissions
VITE_WEB3FORMS_ACCESS_KEY="your_web3forms_access_key_here"

# Telegram Bot Notifications for Inquiries
VITE_TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
VITE_TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# ─── SEO (see docs/seo/01-technical-audit.md) ───
# GA4 measurement ID (format: G-XXXXXXXXXX). Leave empty to disable the tag.
VITE_GA4_ID=""

# Google Search Console verification (the "HTML tag" method — copy only the
# value inside content="..."). Leave empty to omit the meta tag.
VITE_GSC_VERIFICATION=""
